# Copy to .env. Keep secrets on the server; never commit .env.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Optional calibrated GPU worker. Leave unset to use the clearly labeled proxy.
TRIBE_URL=
TRIBE_TOKEN=
TRIBE_DECODER_VERSION=

# Worker-only configuration; see worker/WORKER.md.
TRIBE_CHECKPOINT_DIR=
TRIBE_MODEL_REVISION=
TRIBE_CODE_REVISION=
TRIBE_DECODER_PATH=
