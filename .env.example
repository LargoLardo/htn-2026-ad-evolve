# Copy to .env. Keep secrets on the server; never commit .env.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Optional multimodal reviewer override. Defaults to OPENAI_TEXT_MODEL.
OPENAI_SCREEN_MODEL=

# Optional experimental pattern scorer. Uses an EXISTING feature endpoint;
# this app never starts model downloads, extraction jobs or decoder training.
# Baseten: use BASETEN_TRIBE_ENDPOINT and BASETEN_API_KEY below.
# Alternative full URL implementing the Baseten action=features JSON contract:
TRIBE_FEATURES_URL=
TRIBE_TOKEN=
TRIBE_REFERENCE_PATH=data/experimental/oasis60-yeo7-v1.json
# EVALUATION_CACHE_DIR=data/evaluation-cache

# Archived worker-only configuration; not used by the app's scoring path.
TRIBE_CHECKPOINT_DIR=
TRIBE_MODEL_REVISION=
TRIBE_CODE_REVISION=
TRIBE_DECODER_PATH=
# TRIBE_CACHE_DIR=data/tribe-cache
# TRIBE_HOST=127.0.0.1
# TRIBE_PORT=8091
# FFMPEG_BIN=ffmpeg

# Optional existing Baseten TRIBE feature worker (see experimental/README.md).
BASETEN_API_KEY=
BASETEN_TRIBE_ENDPOINT=
# The Hugging Face read token belongs in Baseten Secrets as hf_access_token.
# OASIS extraction/training and local model downloads are PAUSED by default.
# Do not enable EVOLVE_ENABLE_EXPERIMENTAL_TRAINING globally. The archived
# training docs describe deliberate per-command resumption if requested later.
