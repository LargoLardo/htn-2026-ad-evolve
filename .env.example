# Copy to .env. Keep secrets on the server; never commit .env.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Optional multimodal reviewer override. Defaults to OPENAI_TEXT_MODEL.
OPENAI_SCREEN_MODEL=

# Seedance 2.0 via Pika REST. Required for video generation.
PIKA_API_KEY=

# Updated TRIBE worker. Older action=features endpoints are incompatible.
BASETEN_TRIBE_ENDPOINT=
BASETEN_API_KEY=
# Alternative full scoring URL; optional Bearer token.
TRIBE_SCORE_URL=
TRIBE_TOKEN=
# FFMPEG_BIN=ffmpeg
# EVOLVE_ASSETS_DIR=data/assets
# EVALUATION_CACHE_DIR=data/evaluation-cache

# Archived worker/training configuration; not used by the app's scoring path.
TRIBE_CHECKPOINT_DIR=
TRIBE_MODEL_REVISION=
TRIBE_CODE_REVISION=
TRIBE_DECODER_PATH=
# TRIBE_CACHE_DIR=data/tribe-cache
# The Hugging Face read token belongs in Baseten Secrets as hf_access_token.
# OASIS extraction/training and local model downloads remain PAUSED.
# Do not enable EVOLVE_ENABLE_EXPERIMENTAL_TRAINING globally.
