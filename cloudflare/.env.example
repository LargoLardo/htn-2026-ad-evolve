# Copy to ../.env.cloudflare. Never commit that file or paste tokens into chat.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Cloudflare Access application protecting the frontend; values are not secrets.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Optional custom hostname. Leave blank to start with workers.dev.
ADVOLVE_HOSTNAME=
# Separate Baseten media/DeepGaze service. Existing .env holds other provider keys.
MEDIA_SERVICE_URL=
MEDIA_SERVICE_TOKEN=
