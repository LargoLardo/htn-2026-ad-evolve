{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advolve-web",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": ["/api/*", "/assets/*"] },
  "services": [
    { "binding": "API", "service": "advolve-api" },
    { "binding": "WORKER_SELF_REFERENCE", "service": "advolve-web" }
  ],
  "observability": { "enabled": true }
}
